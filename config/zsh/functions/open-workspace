open-workspace() {
  if [ -z "$1" ]; then
    echo "Usage: open-workspace <workspace-name>"
    return 1
  fi

  if ! command -v fzf &> /dev/null; then
    echo "Error: 'fzf' is required for interactive branch selection. Install via 'brew install fzf'."
    return 1
  fi

  WORKSPACE_NAME="$1"
  WS_DIR="$(pwd)"
  MAIN_FRONTEND="$WS_DIR/frontend"
  MAIN_BACKEND="$WS_DIR/backend"
  MAIN_ENGINE="$WS_DIR/engine"
  TARGET_DIR="$WS_DIR/.worktrees/$WORKSPACE_NAME"

  if [ ! -d "$MAIN_FRONTEND/.git" ] || [ ! -d "$MAIN_BACKEND/.git" ] || [ ! -d "$MAIN_ENGINE/.git" ]; then
    echo "Error: Must be run from workspace root containing frontend, backend, and engine repos."
    return 1
  fi

  echo "Fetching latest remote branches..."
  git -C "$MAIN_FRONTEND" fetch --all --prune
  git -C "$MAIN_BACKEND" fetch --all --prune
  git -C "$MAIN_ENGINE" fetch --all --prune

  select_or_default() {
    local repo_dir="$1"
    local repo_name="$2"
    local selected_branch

    echo "\n--- Select $repo_name branch (Press ESC to use default branch) ---" >&2
    selected_branch=$(git -C "$repo_dir" branch -a | sed -e 's/remotes\/origin\///' -e 's/^\* //' -e 's/^  //' | sort -u | fzf --prompt="$repo_name Branch > ")

    if [ -z "$selected_branch" ]; then
      selected_branch=$(git -C "$repo_dir" symbolic-ref refs/remotes/origin/HEAD 2>/dev/null | sed 's@^refs/remotes/origin/@@')
      [ -z "$selected_branch" ] && selected_branch="main"
      echo "No branch selected for $repo_name. Falling back to default: '$selected_branch'" >&2
    fi

    echo "$selected_branch"
  }

  FE_BRANCH=$(select_or_default "$MAIN_FRONTEND" "FRONTEND")
  BE_BRANCH=$(select_or_default "$MAIN_BACKEND" "BACKEND")
  ENG_BRANCH=$(select_or_default "$MAIN_ENGINE" "ENGINE")

  add_repo_worktree() {
    local repo_dir="$1"
    local target_path="$2"
    local branch="$3"

    # Remove target directory if it exists empty so git worktree doesn't reject it
    rm -rf "$target_path"

    # 1. Local branch exists
    if git -C "$repo_dir" rev-parse --verify --quiet "refs/heads/$branch" >/dev/null; then
      git -C "$repo_dir" worktree add "$target_path" "$branch"
    # 2. Remote branch exists (create local branch to track it)
    elif git -C "$repo_dir" rev-parse --verify --quiet "refs/remotes/origin/$branch" >/dev/null; then
      git -C "$repo_dir" worktree add -b "$branch" "$target_path" "origin/$branch"
    # 3. Fallback: direct checkout
    else
      git -C "$repo_dir" worktree add "$target_path" "$branch"
    fi
  }

  echo "\nCreating worktrees..."
  add_repo_worktree "$MAIN_FRONTEND" "$TARGET_DIR/frontend" "$FE_BRANCH"
  add_repo_worktree "$MAIN_BACKEND" "$TARGET_DIR/backend" "$BE_BRANCH"
  add_repo_worktree "$MAIN_ENGINE" "$TARGET_DIR/engine" "$ENG_BRANCH"

  echo "\nWorkspace created successfully at: $TARGET_DIR"
  echo "Summary:"
  echo " - Frontend: $FE_BRANCH"
  echo " - Backend:  $BE_BRANCH"
  echo " - Engine:   $ENG_BRANCH"

  kiro "$TARGET_DIR"
}